# ── Baza danych (metadane) ──────────────────────────────────────────
# Postgres — TYLKO metadane umów/projektów. Pliki NIGDY nie trafiają do bazy.
# Lokalny dev: przenośny Postgres (pgportable) na 5432 — start.ps1 ogarnia go sam.
DATABASE_URL="postgresql://cru:cru@localhost:5432/cru2026?schema=public"

# ── NextAuth (natywny login login+hasło) ────────────────────────────
NEXTAUTH_URL="http://localhost:3100"
# Wygeneruj: openssl rand -base64 32
NEXTAUTH_SECRET="zmien-mnie-na-losowy-sekret"

# ── Storage plików (abstrakcja StorageAdapter) ──────────────────────
# Adapter lokalny czyta katalog, w którym leży `attachments/` z eksportu bytomskiego
# (klucze w bazie mają postać `attachments/<md5>.<ext>`).
# Docelowo: podmiana na adapter fizycznego serwera / SharePoint / S3 bez zmian w UI.
STORAGE_DRIVER="local"
STORAGE_LOCAL_ROOT="C:/ścieżka/do/eksportu/CRU260811"
